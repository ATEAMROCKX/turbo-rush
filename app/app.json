{
  "expo": {
    "name": "Turbo Rush",
    "slug": "turbo-rush",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12101f",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ateamrockx.turborush",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "com.ateamrockx.turborush",
      "adaptiveIcon": {
        "backgroundColor": "#12101f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#12101f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b350fd28-d6d4-4685-9470-99c49882b6f4"
      }
    },
    "owner": "ateamrockx",
    "updates": {
      "url": "https://u.expo.dev/b350fd28-d6d4-4685-9470-99c49882b6f4"
    }
  }
}
